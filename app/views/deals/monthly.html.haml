- data = {}
- # 登録・編集後のリダイレクト先に関わる情報
- if @account
  - data[:condition] = {account_id: @account.id} # 遷移先を決めるための条件
  - data[:condition_match_url] = monthly_account_deals_path(account_id: @account.id, year: '_YEAR_', month: '_MONTH_')
- data[:result_url] = monthly_deals_path(year: '_YEAR_', month: '_MONTH_') # 条件がないときや、条件に合わなかったときの遷移先
- # 月や口座の切り替えは、この Frame の中身だけを入れ替える。登録フォーム（日付の欄と #deal_forms）は入れ替えずに残して、入力中の内容を保つ
- # Frame の中のリンクは、Frame の中で移動するものに data-turbo: true を付けたものだけ Turbo が扱い、ほかは今までどおりページごと移動する
%turbo-frame#monthly_deals{data: {turbo: 'false', turbo_prefetch: 'false'}}
  #deal_form_option{ data: data }

  .for_monthly_deals.for_deal_editor
    #deals_left
      = link_to '今日', @account ? today_account_deals_path(account_id: @account.id) : today_deals_path, class: %w(btn btn-primary btn-sm), id: :today
      #day_navigator_frame= render :partial => 'shared/day_navigator', :locals => {:month => current_vague_date.beginning_of_month, :data => @day_navigator_data, path_proc: ->(date){ deals_list_path(date: date, account_id: @account&.id) }}

    #deals_right
      #account_selector
        = grouped_account_select "account_id", current_user.accounts, @account.try(:id) || '', prompt: '総合', class: "form-control",
          data: {controller: 'account-selector', action: 'change->account-selector#navigate',
                 account_selector_account_url_template_value: deals_list_path(date: current_vague_date, account_id: '_ACCOUNT_ID_'),
                 account_selector_all_url_value: deals_list_path(date: current_vague_date),
                 account_selector_frame_value: 'monthly_deals'}
        %div{style: "padding: 4px 0 4px 0;"}
          - if @account
            .col-sm-1
              %a{href: setting_account_path(@account)}
                %span.glyphicon.glyphicon-wrench
            .col-sm-1
              - if @account.description.present?
                = render partial: 'shared/account_memo', locals: {account: @account}
      - if @account
        = link_to '総合', deals_list_path(date: current_vague_date), class: %w(btn btn-default monthly_deals_link), data: {url_template: monthly_deals_path(year: '_YEAR_', month: '_MONTH_'), turbo: true, turbo_action: 'advance'}
      - account_selection_histories.each do |a|
        - if @account != a
          = account_button(a, date: current_vague_date, data: {turbo: true, turbo_action: 'advance'})

      #deal_pattern_frame{data: {url: recent_deal_patterns_path, mode: 'always'}}
        = render :partial => 'shared/deal_patterns/recent'

    #deals_main
      #deals_frame
        #deals_navigator
          #calendar_in_navigator
            = render partial: "shared/calendar", :locals => {year: current_vague_date.year, month: current_vague_date.month, url_template: monthly_deals_list_path_template(@account&.id), frame: 'monthly_deals'}
        #new_deal_window
          - # 折れ線グラフ
          #chart{style: "margin-top: 0px; width: 55%; height: 50px; float: left;"}
            = line_chart @expenses_summary.items , :width => 550, :height => 80, :canvas_id => 'expense_summary_graph', :x => @months_for_expenses, :gbackgroundColor => "'#ffe5f2'", :y => @expenses_summary.y, :yMin => @expenses_summary.y_min, :yMax => @expenses_summary.y_max

          - # 精算
          - if @settlement_summaries
            #settlements{style: "float: right; width: 35%;"}
              = render partial: '/settlements/summary', locals: {gadget: true}

          %div{style: "clear: both;"}

          - # ここに h3 してもいい
          .deal_editor
            - deal_type = flash[:"#{controller_name}_deal_type"]
            = deal_editor 1, current_vague_date.year, current_vague_date.month, current_vague_date.day, frame: 'monthly_deals', month_url_template: monthly_deals_list_path_template(@account&.id) do
              = render :partial => deal_type == 'balance_deal' ? 'balance_deal_form' : @deal.complex? ? 'complex_deal_form' : 'general_deal_form'
        - # 月の一覧タブはいつも出し、日で絞っているときは日の一覧タブも出して、最初は日の一覧タブを表示する
        - # data の日と口座は、口座を切り替えたときに見ていたタブを保つために使う
        - list_name = @account ? @account.name : '総合'
        %ul.nav.nav-tabs.nav-justified.body_tab#monthly_deals_body_tab{style: "margin-top: 8px;", data: {day: current_vague_date.day, account_id: @account&.id}}
          %li{roll: "presentation", class: current_vague_date.day ? nil : 'active'}
            %a.body_tab_link{data: "monthly", href: "#monthly"} #{list_name}(#{current_vague_date.year}年 #{current_vague_date.month}月)
          - if current_vague_date.day
            %li{roll: "presentation", class: 'active'}
              %a.body_tab_link{data: "daily", href: "#daily"} #{list_name}(#{current_vague_date.year}年#{current_vague_date.month}月#{current_vague_date.day}日)
          %li{roll: "presentation"}
            %a.body_tab_link{data: "recent", href: "#recent"} 最近の記入
        #monthly_contents
          #book.bottom_box
            - # 同じ記入の行が日と月の両方の一覧に出る。URL の #d123 で表示中の日の一覧の行に移れるよう、日の一覧を先に置く
            - if current_vague_date.day
              .body_tab_area#daily_area
                - if @account
                  = render partial: "account_entries", locals: {account_entries: @daily_account_entries, list_date: current_vague_date}
                - else
                  = render partial: "deals", locals: {deals: @daily_deals, list_date: current_vague_date}
            .body_tab_area#monthly_area{style: current_vague_date.day ? "display: none;" : nil}
              - if @account
                = render partial: "account_entries", locals: {account_entries: @account_entries, list_date: VagueDate.new(current_vague_date.year, current_vague_date.month)}
              - else
                = render partial: "deals", locals: {deals: @deals, list_date: VagueDate.new(current_vague_date.year, current_vague_date.month)}
            .body_tab_area#recent_area{style: "display: none;"}
              = render :partial => "deals", locals: {deals: @recently_updated_deals}

      = render partial: 'monthly_js'
