- # 日ナビゲーター
- # month - 表示する月の初日
- # path_proc - 日からのリンク先をブロックで渡す。なければ ""
- # data - date というメソッドを持つオブジェクトの配列
- path_proc ||= nil
%table#day_navigator
  %tr
    %td.year_month
      = "#{month.year}年#{month.month}月"
    - date = month
    - while date.month == month.month
      %tr
        %td.day
          %div{class: "cwday#{date.cwday}#{date == Time.zone.today ? ' today' : ''}"}
            = link_to l(date, :format => :day), path_proc ? path_proc.call(date) : '#', data: {turbo: true, turbo_action: 'advance'}
        %td= '*' if data.any?{|d| d.date == date }
      - date += 1
